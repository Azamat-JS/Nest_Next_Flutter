// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  status      TenantStatus @default(ACTIVE)
  botToken    String?
  botUsername String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users           Users[]
  sessions        Session[]
  deviceTokens    DeviceToken[]
  parentStudents  ParentStudent[]
  studentGroups   StudentGroup[]
  groups          Groups[]
  scoreEvents     ScoreEvent[]
  studentScores   StudentScore[]
  studentPayments StudentPayment[]
  chats           Chat[]
  chatMembers     ChatMember[]
  messages        Message[]
  messageStatuses MessageStatus[]
  attachments     Attachment[]
  waitingList     WaitingList[]
  homeworks       Homework[]

  @@map("Tenant")
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformAdmin")
}

model Users {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String?
  phone              String   @unique
  password           String
  role               UserRole @default(STUDENT)
  avatarUrl          String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teachingGroups Groups[] @relation("TeacherGroups")

  chats          ChatMember[]
  messages       Message[]
  messageStatus  MessageStatus[]
  parents        ParentStudent[]  @relation("StudentRelations")
  children       ParentStudent[]  @relation("ParentRelations")
  studentGroups  StudentGroup[]
  scoreEvents    ScoreEvent[]
  studentScore   StudentScore[]
  sessions       Session[]
  devices        DeviceToken[]
  studentPayment StudentPayment[]

  @@index([phone])
  @@index([tenantId])
  @@map("Users")
}

model WaitingList {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  phone     String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([phone])
  @@index([tenantId])
  @@map("WaitingList")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   Users  @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  deviceInfo String?
  isRevoked  Boolean @default(false)

  @@index([tenantId])
  @@map("Session")
}

model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   Users  @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fcmToken String @unique

  deviceType String?
  deviceName String?
  appVersion String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("DeviceToken")
}

model ParentStudent {
  id       String @id @default(cuid())
  parentId String
  parent   Users  @relation("ParentRelations", fields: [parentId], references: [id])

  studentId String
  student   Users  @relation("StudentRelations", fields: [studentId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("ParentStudent")
}

model StudentGroup {
  id        String @id @default(cuid())
  studentId String
  student   Users  @relation(fields: [studentId], references: [id])

  groupId String
  group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentGroup")
}

model Groups {
  id   String @id @default(cuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teacherId String
  teacher   Users          @relation("TeacherGroups", fields: [teacherId], references: [id])
  students  StudentGroup[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  scoreEvents     ScoreEvent[]
  studentScores   StudentScore[]
  studentPayments StudentPayment[]
  homeworks       Homework[]

  @@unique([tenantId, name])
  @@index([teacherId])
  @@index([tenantId])
  @@map("Groups")
}

model ScoreEvent {
  id        String @id @default(cuid())
  studentId String
  student   Users  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type    ScoreType
  value   Int
  comment String?

  groupId   String
  group     Groups   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId, type, date])
  @@index([tenantId, studentId, groupId, type, date])
  @@map("ScoreEvent")
}

model StudentScore {
  studentId String
  groupId   String

  student Users @relation(fields: [studentId], references: [id], onDelete: Cascade)

  group Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  total      Int      @default(0)
  homework   Int      @default(0)
  attendance Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentScore")
}

model StudentPayment {
  id String @id @default(uuid())

  studentId String
  groupId   String

  student Users  @relation(fields: [studentId], references: [id])
  group   Groups @relation(fields: [groupId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  month Int
  year  Int

  amount Decimal @db.Decimal(10, 2)

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId, month, year])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentPayment")
}

model Homework {
  id      String   @id @default(cuid())
  topic   String
  dueDate DateTime

  groupId String
  group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([tenantId])
  @@map("Homework")
}

model Chat {
  id        String   @id @default(cuid())
  name      String?
  type      ChatType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  members  ChatMember[]
  messages Message[]

  @@index([tenantId])
  @@map("Chat")
}

model ChatMember {
  id       String   @id @default(cuid())
  user     Users    @relation(fields: [userId], references: [id])
  userId   String
  chat     Chat     @relation(fields: [chatId], references: [id])
  chatId   String
  joinedAt DateTime @default(now())
  isAdmin  Boolean  @default(false)
  isMuted  Boolean  @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, chatId])
  @@index([tenantId])
  @@map("ChatMember")
}

model Message {
  id          String      @id @default(cuid())
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId      String
  sender      Users       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  content     String
  type        MessageType @default(TEXT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deliveredAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  messageStatus MessageStatus[]
  attachments   Attachment[]

  @@index([chatId])
  @@index([senderId])
  @@index([tenantId])
  @@map("Message")
}

model MessageStatus {
  id        String    @id @default(cuid())
  message   Message   @relation(fields: [messageId], references: [id])
  messageId String
  user      Users     @relation(fields: [userId], references: [id])
  userId    String
  readAt    DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("MessageStatus")
}

model Attachment {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id])
  messageId String
  url       String
  type      String
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("Attachments")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum ChatType {
  DIRECT
  GROUP
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum ScoreType {
  HOMEWORK
  ATTENDANCE
  EXAM
  QUIZ
}
