// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      UserRole @default(STUDENT)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teachingGroups Groups[] @relation("TeacherGroups")

  chats         ChatMember[]
  messages      Message[]
  messageStatus MessageStatus[]
  parents       ParentStudent[] @relation("StudentRelations")
  children      ParentStudent[] @relation("ParentRelations")
  studentGroups StudentGroup[]
  scoreEvents   ScoreEvent[]
  studentScore  StudentScore[]

  @@index([email])
  @@map("Users")
}

model ParentStudent {
  id       String @id @default(cuid())
  parentId String
  parent   Users  @relation("ParentRelations", fields: [parentId], references: [id])

  studentId String
  student   Users  @relation("StudentRelations", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("ParentStudent")
}

model StudentGroup {
  id        String @id @default(cuid())
  studentId String
  student   Users  @relation(fields: [studentId], references: [id])

  groupId String
  group   Groups @relation(fields: [groupId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@map("StudentGroup")
}

model Groups {
  id   String @id @default(cuid())
  name String @unique

  teacherId String
  teacher   Users          @relation("TeacherGroups", fields: [teacherId], references: [id])
  students  StudentGroup[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  scoreEvents ScoreEvent[]
  studentScores StudentScore[]

  @@index([teacherId])
  @@map("Groups")
}

model ScoreEvent {
    id   String @id @default(cuid())
    studentId String
    student Users @relation(fields: [studentId], references: [id])

    type ScoreType
    value Int

    groupId String
    group Groups @relation(fields: [groupId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([studentId, type, groupId])
    @@index([studentId])
    @@index([groupId])
    @@map("ScoreEvent")
}

model StudentScore{
  studentId String
    groupId String

  student Users @relation(fields: [studentId], references: [id])

    group Groups @relation(fields: [groupId], references: [id])

  total Int @default(0)
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([groupId])
  @@id([studentId, groupId])
  @@map("StudentScore")
}

model Chat {
  id        String   @id @default(cuid())
  name      String?
  type      ChatType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]

  @@map("Chat")
}

model ChatMember {
  id       String   @id @default(cuid())
  user     Users    @relation(fields: [userId], references: [id])
  userId   String
  chat     Chat     @relation(fields: [chatId], references: [id])
  chatId   String
  joinedAt DateTime @default(now())
  isAdmin  Boolean  @default(false)
  isMuted  Boolean  @default(false)

  @@unique([userId, chatId])
  @@map("ChatMember")
}

model Message {
  id          String      @id @default(cuid())
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId      String
  sender      Users       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  content     String
  type        MessageType @default(TEXT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deliveredAt DateTime?

  messageStatus MessageStatus[]
  attachments   Attachment[]

  @@index([chatId])
  @@index([senderId])
  @@map("Message")
}

model MessageStatus {
  id        String    @id @default(cuid())
  message   Message   @relation(fields: [messageId], references: [id])
  messageId String
  user      Users     @relation(fields: [userId], references: [id])
  userId    String
  readAt    DateTime?

  @@map("MessageStatus")
}

model Attachment {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id])
  messageId String
  url       String
  type      String
  createdAt DateTime @default(now())

  @@map("Attachments")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum ChatType {
  DIRECT
  GROUP
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum ScoreType {
  HOMEWORK
  ATTENDANCE
  EXAM
  QUIZ
}
