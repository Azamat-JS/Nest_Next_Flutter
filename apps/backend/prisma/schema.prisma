// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String       @id @default(cuid())
  name          String
  status        TenantStatus @default(ACTIVE)
  botToken      String?
  botUsername   String?
  webhookSecret String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users           Users[]
  sessions        Session[]
  deviceTokens    DeviceToken[]
  parentStudents  ParentStudent[]
  studentGroups   StudentGroup[]
  groups          Groups[]
  scoreEvents     ScoreEvent[]
  studentScores   StudentScore[]
  studentPayments StudentPayment[]
  chats           Chat[]
  chatMembers     ChatMember[]
  messages        Message[]
  messageStatuses MessageStatus[]
  attachments     Attachment[]
  waitingList     WaitingList[]
  homeworks       Homework[]
  telegramLinks   TelegramLink[]
  lessonSchedules GroupLessonSchedule[]
  rooms           Room[]

  @@map("Tenant")
}

model PlatformAdmin {
  id        String   @id @default(cuid())
  phone     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PlatformAdmin")
}

model Users {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String?
  phone              String   @unique
  password           String
  role               UserRole @default(STUDENT)
  avatarUrl          String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teachingGroups Groups[] @relation("TeacherGroups")

  chats          ChatMember[]
  messages       Message[]
  messageStatus  MessageStatus[]
  parents        ParentStudent[]  @relation("StudentRelations")
  children       ParentStudent[]  @relation("ParentRelations")
  studentGroups  StudentGroup[]
  scoreEvents    ScoreEvent[]
  studentScore   StudentScore[]
  sessions       Session[]
  devices        DeviceToken[]
  studentPayment StudentPayment[]
  telegramLinks  TelegramLink[]

  @@index([phone])
  @@index([tenantId])
  @@map("Users")
}

// Links a Telegram account to a PARENT or STUDENT user of one tenant's bot.
// `verified` is true only when the phone came from Telegram's contact-share
// (attested to belong to the sender); manually typed phones stay unverified.
model TelegramLink {
  id String @id @default(cuid())

  userId String
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  telegramUserId String
  chatId         String
  phone          String
  verified       Boolean @default(false)
  // Failed password attempts while a manually-typed phone awaits
  // verification; the pending link is discarded when the limit is hit.
  verifyAttempts Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, telegramUserId])
  @@index([userId])
  @@index([tenantId])
  @@map("TelegramLink")
}

// Bot language preference per Telegram user, independent of TelegramLink so
// it can be set (via /language) before a phone-linked account exists.
model TelegramUserLanguage {
  id String @id @default(cuid())

  tenantId       String
  telegramUserId String
  language       String @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, telegramUserId])
  @@map("TelegramUserLanguage")
}

model WaitingList {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  phone     String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([phone])
  @@index([tenantId])
  @@map("WaitingList")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   Users  @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  deviceInfo String?
  isRevoked  Boolean @default(false)

  @@index([tenantId])
  @@map("Session")
}

model DeviceToken {
  id     String @id @default(cuid())
  userId String
  user   Users  @relation(fields: [userId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fcmToken String @unique

  deviceType String?
  deviceName String?
  appVersion String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@map("DeviceToken")
}

model ParentStudent {
  id       String @id @default(cuid())
  parentId String
  parent   Users  @relation("ParentRelations", fields: [parentId], references: [id])

  studentId String
  student   Users  @relation("StudentRelations", fields: [studentId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("ParentStudent")
}

model StudentGroup {
  id        String @id @default(cuid())
  studentId String
  student   Users  @relation(fields: [studentId], references: [id])

  groupId String
  group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentGroup")
}

model Groups {
  id   String @id @default(cuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teacherId String
  teacher   Users          @relation("TeacherGroups", fields: [teacherId], references: [id])
  students  StudentGroup[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  scoreEvents     ScoreEvent[]
  studentScores   StudentScore[]
  studentPayments StudentPayment[]
  homeworks       Homework[]
  lessonSchedules GroupLessonSchedule[]

  @@unique([tenantId, name])
  @@index([teacherId])
  @@index([tenantId])
  @@map("Groups")
}

// Weekly lesson slots for a group: which days lessons run and at what time.
// dayOfWeek follows ISO-8601: 1 = Monday ... 7 = Sunday. time is "HH:mm" (24h).
model GroupLessonSchedule {
  id String @id @default(cuid())

  groupId String
  group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  dayOfWeek Int
  time      String
  // Lesson length in minutes; used to draw room-occupancy blocks.
  durationMinutes Int @default(90)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, dayOfWeek])
  @@index([groupId])
  @@index([tenantId])
  @@index([roomId])
  @@map("GroupLessonSchedule")
}

// Physical classroom of a tenant; lessons are assigned to rooms to build the
// occupancy timetable on the dashboard.
model Room {
  id   String @id @default(cuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  lessonSchedules GroupLessonSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("Room")
}

model ScoreEvent {
  id        String @id @default(cuid())
  studentId String
  student   Users  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type    ScoreType
  value   Int
  comment String?

  groupId   String
  group     Groups   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId, type, date])
  @@index([tenantId, studentId, groupId, type, date])
  @@map("ScoreEvent")
}

model StudentScore {
  studentId String
  groupId   String

  student Users @relation(fields: [studentId], references: [id], onDelete: Cascade)

  group Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  total      Int      @default(0)
  homework   Int      @default(0)
  attendance Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentScore")
}

model StudentPayment {
  id String @id @default(uuid())

  studentId String
  groupId   String

  student Users  @relation(fields: [studentId], references: [id])
  group   Groups @relation(fields: [groupId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  month Int
  year  Int

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(CASH)

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, groupId, month, year])
  @@index([studentId])
  @@index([groupId])
  @@index([tenantId])
  @@map("StudentPayment")
}

model Homework {
  id      String   @id @default(cuid())
  topic   String
  dueDate DateTime
  // The scheduled lesson day this homework was assigned on, stored at UTC
  // midnight of that calendar date. Null on rows created before the field existed.
  lessonDate DateTime?

  groupId String
  group   Groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([tenantId])
  @@map("Homework")
}

model Chat {
  id        String   @id @default(cuid())
  name      String?
  type      ChatType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  members  ChatMember[]
  messages Message[]

  @@index([tenantId])
  @@map("Chat")
}

model ChatMember {
  id       String   @id @default(cuid())
  user     Users    @relation(fields: [userId], references: [id])
  userId   String
  chat     Chat     @relation(fields: [chatId], references: [id])
  chatId   String
  joinedAt DateTime @default(now())
  isAdmin  Boolean  @default(false)
  isMuted  Boolean  @default(false)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, chatId])
  @@index([tenantId])
  @@map("ChatMember")
}

model Message {
  id          String      @id @default(cuid())
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId      String
  sender      Users       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId    String
  content     String
  type        MessageType @default(TEXT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deliveredAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  messageStatus MessageStatus[]
  attachments   Attachment[]

  @@index([chatId])
  @@index([senderId])
  @@index([tenantId])
  @@map("Message")
}

model MessageStatus {
  id        String    @id @default(cuid())
  message   Message   @relation(fields: [messageId], references: [id])
  messageId String
  user      Users     @relation(fields: [userId], references: [id])
  userId    String
  readAt    DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("MessageStatus")
}

model Attachment {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id])
  messageId String
  url       String
  type      String
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("Attachments")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

enum ChatType {
  DIRECT
  GROUP
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum ScoreType {
  HOMEWORK
  ATTENDANCE
  EXAM
  QUIZ
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  CLICK
}
